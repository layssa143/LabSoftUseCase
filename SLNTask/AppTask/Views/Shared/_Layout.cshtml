<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#f4f0e8" />

    <title>
        @ViewData["Title"] · AppTask
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AppTask.styles.css"
          asp-append-version="true" />

</head>


<body>

    <div class="site-frame">


        <!-- =========================
             SIDEBAR
        ========================== -->

        <aside class="editorial-sidebar"
               id="sidebar">


            <div class="brand-area">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand-link">

                    <span class="brand-symbol">
                        AT
                    </span>

                    <span class="brand-name">
                        AppTask
                    </span>

                </a>

            </div>


            <div class="sidebar-label">
                Workspace
            </div>


            <nav class="main-navigation">


                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        01
                    </span>

                    <span>
                        Visão geral
                    </span>

                </a>


                <a asp-controller="Tarefa"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        02
                    </span>

                    <span>
                        Tarefas
                    </span>

                </a>


                <a asp-controller="Incidente"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        03
                    </span>

                    <span>
                        Incidentes
                    </span>

                </a>


                <a asp-controller="Funcionario"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        04
                    </span>

                    <span>
                        Funcionários
                    </span>

                </a>


                <div class="sidebar-divider"></div>


                <div class="sidebar-label">
                    Organização
                </div>


                <a asp-controller="Departamento"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        05
                    </span>

                    <span>
                        Departamentos
                    </span>

                </a>


                <a asp-controller="CentralCusto"
                   asp-action="Index"
                   class="nav-entry">

                    <span class="nav-number">
                        06
                    </span>

                    <span>
                        Centros de custo
                    </span>

                </a>


                <a asp-controller="Tarefa"
                   asp-action="Sobre"
                   class="nav-entry">

                    <span class="nav-number">
                        07
                    </span>

                    <span>
                        Sobre
                    </span>

                </a>


            </nav>


            <div class="sidebar-bottom">

                <div class="mini-status">

                    <span class="status-indicator"></span>

                    <span>
                        Sistema ativo
                    </span>

                </div>


                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="privacy-link">

                    Privacidade

                </a>

            </div>


        </aside>



        <!-- =========================
             CONTEÚDO
        ========================== -->

        <div class="site-content">


            <!-- TOPBAR -->

            <header class="editorial-topbar">


                <button type="button"
                        class="mobile-menu"
                        id="menuButton"
                        aria-label="Abrir menu">

                    <span></span>
                    <span></span>

                </button>


                <div class="breadcrumb-line">

                    <span class="breadcrumb-home">
                        APP TASK
                    </span>

                    <span class="breadcrumb-separator">
                        /
                    </span>

                    <span>
                        @ViewData["Title"]
                    </span>

                </div>


                <div class="profile-area">

                    <div class="profile-text">

                        <strong>
                            Administrador
                        </strong>

                        <small>
                            Workspace interno
                        </small>

                    </div>


                    <div class="profile-avatar">
                        A
                    </div>

                </div>


            </header>



            <!-- MAIN -->

            <main role="main"
                  class="page-content">

                @RenderBody()

            </main>



            <!-- FOOTER -->

            <footer class="editorial-footer">

                <span>
                    © 2026 AppTask
                </span>

                <span>
                    Gestão operacional
                </span>

            </footer>


        </div>


    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>