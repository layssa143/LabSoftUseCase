@{
    ViewData["Title"] = "Visão geral";
}


<div class="home-page">


    <!-- =================================
         HERO
    ================================== -->

    <section class="editorial-hero">


        <div class="hero-copy">

            <div class="overline">
                PAINEL OPERACIONAL
            </div>


            <h1>
                Tudo que importa,
                <em>em um só lugar.</em>
            </h1>


            <p>
                Acompanhe tarefas, pessoas, incidentes
                e estruturas da operação através de uma
                visão simples e organizada.
            </p>


            <div class="hero-actions">

                <a asp-controller="Tarefa"
                   asp-action="Create"
                   class="editorial-button">

                    Nova tarefa

                    <span>
                        →
                    </span>

                </a>


                <a asp-controller="Tarefa"
                   asp-action="Index"
                   class="text-action">

                    Ver tarefas

                </a>

            </div>

        </div>


        <div class="hero-note">

            <span class="note-line"></span>

            <span>
                Atualização do sistema
            </span>

            <strong>
                04.09.2026
            </strong>

        </div>


    </section>



    <!-- =================================
         INDICADORES
    ================================== -->

    <section class="metrics-section">


        <div class="section-intro">

            <span>
                01
            </span>

            <h2>
                Panorama
            </h2>

        </div>


        <div class="metrics-grid">


            <a asp-controller="Tarefa"
               asp-action="Index"
               class="metric-card metric-featured">

                <div class="metric-top">

                    <span>
                        Tarefas
                    </span>

                    <span class="metric-arrow">
                        ↗
                    </span>

                </div>

                <strong>
                    —
                </strong>

                <p>
                    Acompanhe suas atividades
                    e respectivos status.
                </p>

            </a>


            <a asp-controller="Incidente"
               asp-action="Index"
               class="metric-card">

                <div class="metric-top">

                    <span>
                        Incidentes
                    </span>

                    <span class="metric-arrow">
                        ↗
                    </span>

                </div>

                <strong>
                    —
                </strong>

                <p>
                    Ocorrências registradas
                    no sistema.
                </p>

            </a>


            <a asp-controller="Funcionario"
               asp-action="Index"
               class="metric-card">

                <div class="metric-top">

                    <span>
                        Funcionáros
                    </span>

                    <span class="metric-arrow">
                        ↗
                    </span>

                </div>

                <strong>
                    —
                </strong>

                <p>
                    Funcionários cadastrados
                    na operação.
                </p>

            </a>


        </div>

    </section>



    <!-- =================================
         ÁREAS
    ================================== -->

    <section class="areas-section">


        <div class="section-heading">


            <div>

                <span class="section-index">
                    02
                </span>

                <h2>
                    Áreas do sistema
                </h2>

            </div>


            <p>
                Navegue pelas principais áreas
                do AppTask.
            </p>


        </div>



        <div class="areas-list">


            <a asp-controller="Tarefa"
               asp-action="Index"
               class="area-row">

                <span class="area-id">
                    01
                </span>

                <span class="area-title">
                    Tarefas
                </span>

                <span class="area-description">
                    Atividades e acompanhamento
                </span>

                <span class="area-arrow">
                    →
                </span>

            </a>


            <a asp-controller="Funcionario"
               asp-action="Index"
               class="area-row">

                <span class="area-id">
                    02
                </span>

                <span class="area-title">
                    Funcionários
                </span>

                <span class="area-description">
                    Pessoas e responsabilidades
                </span>

                <span class="area-arrow">
                    →
                </span>

            </a>


            <a asp-controller="Incidente"
               asp-action="Index"
               class="area-row">

                <span class="area-id">
                    03
                </span>

                <span class="area-title">
                    Incidentes
                </span>

                <span class="area-description">
                    Ocorrências e resoluções
                </span>

                <span class="area-arrow">
                    →
                </span>

            </a>


            <a asp-controller="Departamento"
               asp-action="Index"
               class="area-row">

                <span class="area-id">
                    04
                </span>

                <span class="area-title">
                    Departamentos
                </span>

                <span class="area-description">
                    Estrutura organizacional
                </span>

                <span class="area-arrow">
                    →
                </span>

            </a>


            <a asp-controller="CentralCusto"
               asp-action="Index"
               class="area-row">

                <span class="area-id">
                    05
                </span>

                <span class="area-title">
                    Centros de custo
                </span>

                <span class="area-description">
                    Controle financeiro
                </span>

                <span class="area-arrow">
                    →
                </span>

            </a>


        </div>


    </section>



    <!-- =================================
         FRASE FINAL
    ================================== -->

    <section class="closing-note">

        <span>
            APP TASK
        </span>

        <p>
            Organização não precisa ser complicada.
        </p>

    </section>


</div>