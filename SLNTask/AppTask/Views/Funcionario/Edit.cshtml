@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Editar funcionário";
}

<h1>Editar Funcionário</h1>

<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Codigo" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">NOME COMPLETO</label>
        <input asp-for="Nome"
               class="form-control"
               autocomplete="off" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cargo" class="form-label">CARGO</label>
        <input asp-for="Cargo"
               class="form-control"
               autocomplete="off" />
        <span asp-validation-for="Cargo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CodigoGerente" class="form-label">GERENTE</label>

        <select asp-for="CodigoGerente"
                class="form-select"
                asp-items="ViewBag.ListaGerentes">
            <option value="">-- Selecione --</option>
        </select>

        <span asp-validation-for="CodigoGerente" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        SALVAR ALTERAÇÕES
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        VOLTAR PARA A LISTA
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}