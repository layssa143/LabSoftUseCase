@model AppTask.Models.CentralCusto

@{
    ViewData["Title"] = "Novo Centro de Custo";
}

<h1 class="mb-4">Cadastrar Novo Centro de Custo</h1>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="NomeCusto" class="form-label">
                    Nome do Centro de Custo
                </label>

                <input asp-for="NomeCusto"
                       class="form-control"
                       placeholder="Digite o nome do centro de custo"
                       required />

                <span asp-validation-for="NomeCusto"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorAnualMeta" class="form-label">
                    Valor Anual da Meta
                </label>

                <input asp-for="ValorAnualMeta"
                       class="form-control"
                       placeholder="Digite o valor anual da meta"
                       type="number"
                       step="0.01"
                       min="0"
                       required />

                <span asp-validation-for="ValorAnualMeta"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3 d-flex gap-2">

                <button type="submit" class="btn btn-primary">
                    Salvar Centro de Custo
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Voltar para a Lista
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
