@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Index";
}

<h1 class="mb-4">Lista de Departamentos</h1>

<p>
    <a href="/Departamento/Create" class="btn btn-success text-white">Novo</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Descrição do Departamento</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DescricaoDepartamento</td>
                <td>@item.Ativo</td>
                <td>
                    <a href="/Departamento/Edit/@item.Codigo"
                       class="btn btn-primary btn-sm text-white">
                        Alterar
                    </a>

                    <a href="/Departamento/Details/@item.Codigo"
                       class="btn btn-success btn-sm text-white"
                       style="background-color: #006400;">
                        Detalhe
                    </a>

                    <button type="button"
                            class="btn btn-danger btn-sm text-white"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-descricao="@item.DescricaoDepartamento">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    Confirmação de Exclusão
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                Deseja realmente excluir o departamento:
                <strong id="DescricaoDepartamento"></strong>?
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="modal-btn-cancel btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Sim, Excluir
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            // Botão Delete que foi clicado
            var button = event.relatedTarget;

            // Pega o código do departamento
            var id = button.getAttribute('data-id');

            // Pega o nome/descrição do departamento
            var descricao = button.getAttribute('data-descricao');

            // Exibe a descrição no modal
            var modalDescricao = deleteModal.querySelector('#DescricaoDepartamento');
            modalDescricao.textContent = descricao;

            // Define a URL que será chamada pelo POST
            var deleteForm = deleteModal.querySelector('#deleteForm');
            deleteForm.action = '/Departamento/Delete/' + id;
        });
    </script>
    }