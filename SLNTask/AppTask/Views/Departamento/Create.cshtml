@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<h1 class="mb-4">Cadastrar Novo Departamento</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/Departamento/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="DescricaoDepartamento" class="form-label font-weight-bold">Descrição do Departamento</label>
                <input type="text"
                       id="DescricaoDepartamento"
                       name="DescricaoDepartamento"
                       class="form-control"
                       placeholder="Digite a descrição do departamento"
                       required />
            </div>

            <div class="mb-3">
                <label for="Ativo" class="form-label">Ativo</label>
                <select id="Ativo" name="Ativo" class="form-select" required>
                    <option value="">-- Selecione --</option>
                    <option value="Sim">Sim</option>
                    <option value="Não">Não</option>
                </select>
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Departamento</button>
                <a href="/Departamento/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>
